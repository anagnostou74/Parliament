<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/card_margin"
    android:minHeight="120dp"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Εικόνα αριστερά -->
        <ImageView
            android:id="@+id/cal_imageTxtView"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/photos"
            app:srcCompat="@drawable/ic_splash"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/detailsTxtView"
            app:layout_constraintVertical_bias="0" />

        <!-- Τύπος -->
        <TextView
            android:id="@+id/typeTxtView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="?android:textColorPrimary"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@id/cal_imageTxtView"
            app:layout_constraintStart_toEndOf="@id/cal_imageTxtView"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="12dp" />

        <!-- Τοποθεσία -->
        <TextView
            android:id="@+id/placeTxtView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?android:textColorPrimary"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/typeTxtView"
            app:layout_constraintStart_toStartOf="@id/typeTxtView"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp" />

        <!-- Ημερομηνία -->
        <TextView
            android:id="@+id/dateTxtView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="?android:textColorPrimary"
            app:layout_constraintTop_toBottomOf="@id/placeTxtView"
            app:layout_constraintStart_toStartOf="@id/typeTxtView"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp" />

        <!-- Ώρα -->
        <TextView
            android:id="@+id/timeTxtView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?android:textColorSecondary"
            app:layout_constraintTop_toBottomOf="@id/dateTxtView"
            app:layout_constraintStart_toStartOf="@id/typeTxtView"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp" />

        <!-- Λεπτομέρειες – πλήρους πλάτους ΚΑΤΩ ΑΠΟ ΟΛΑ -->
        <TextView
            android:id="@+id/detailsTxtView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="?android:textColorPrimary"
            android:autoLink="web"
            app:layout_constraintTop_toBottomOf="@id/timeTxtView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btnReminder" />

        <!-- Καμπανάκι στο κέντρο κάτω -->
        <ImageButton
            android:id="@+id/btnReminder"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/remind_me"
            android:padding="6dp"
            android:tint="?attr/colorControlNormal"
            app:srcCompat="@drawable/ic_bell"
            app:layout_constraintTop_toBottomOf="@id/detailsTxtView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
